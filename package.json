{
  "name": "bpg-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bpg/desktop dev",
    "build": "pnpm --filter @bpg/desktop build",
    "typecheck": "tsc --noEmit -p tsconfig.packages.json && pnpm --filter @bpg/desktop typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "dist:win": "pnpm --filter @bpg/desktop dist:win"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
